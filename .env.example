DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_SSL=true
# Chỉ dùng để tạo quản trị viên ĐẦU TIÊN khi bảng admin_users còn trống.
# Sau đó quản lý tài khoản và đổi mật khẩu trong trang quản trị.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-unique-password
PORT=4000
# Set to the exact trusted reverse proxy hop count or address range in deployment.
TRUST_PROXY=0
# Tùy chọn: tự xóa lịch sử hoạt động cũ hơn N ngày (tối thiểu 30). Bỏ trống = giữ vĩnh viễn.
ACTIVITY_RETENTION_DAYS=
