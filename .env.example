DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_SSL=true
# Supabase: đường dẫn file CA tải ở Dashboard > Database > SSL Configuration (bắt buộc khi DATABASE_SSL=true).
DATABASE_SSL_CA=
# Chỉ dùng để tạo quản trị viên ĐẦU TIÊN khi bảng admin_users còn trống.
# Sau đó quản lý tài khoản và đổi mật khẩu trong trang quản trị.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-unique-password
# Khóa mã hóa secret 2FA (32 byte base64). BẮT BUỘC khi dùng 2FA; sao lưu tách
# riêng với database (mất khóa = mọi người phải đăng ký 2FA lại). Tạo bằng:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOTP_ENCRYPTION_KEY=
# Vai trò bắt buộc 2FA. Không đặt = admin,editor (mặc định). "none" = tắt bắt
# buộc, chỉ dùng tạm khi trang quản trị chưa có giao diện đăng ký 2FA.
TWO_FACTOR_REQUIRED_ROLES=admin,editor
PORT=4000
# VPS: 127.0.0.1 để API chỉ nhận kết nối từ Next cùng máy. Bỏ trống = mọi địa chỉ.
HOST=
# Set to the exact trusted reverse proxy hop count or address range in deployment.
TRUST_PROXY=0
# VPS (Nginx → Next → API cùng máy): TRUST_PROXY=loopback
# Tùy chọn: tự xóa lịch sử hoạt động cũ hơn N ngày (tối thiểu 30). Bỏ trống = giữ vĩnh viễn.
ACTIVITY_RETENTION_DAYS=
